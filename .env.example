# Copy to .env and fill in. .env is git-ignored; never commit it.

# From @BotFather
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user ID (only this user can use the bot), e.g. from @userinfobot
TELEGRAM_OWNER_ID=

# From https://my.telegram.org -> API development tools (used by the local Bot API server)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Local Bot API server, needed for files over 20 MB
TELEGRAM_API_URL=http://127.0.0.1:8081
# Host folder mounted into the Bot API container as /var/lib/telegram-bot-api
LOCAL_API_ROOT=/path/to/telegram-bot-api-data

# Inngest dev server
INNGEST_DEV=1
INNGEST_BASE_URL=http://127.0.0.1:8288

# Optional, defaults to ~/Downloads/telegram
# DOWNLOAD_DIR=

# Optional tuning
# PARALLEL_DOWNLOADS=2   # files downloaded at the same time
# MAX_RETRIES=8          # retries per file before it is marked failed (use /retry)
